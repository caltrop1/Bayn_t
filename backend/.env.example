APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production must set CORS_ALLOWED_ORIGINS to an explicit comma-separated allowlist.

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bayn_t
DB_USERNAME=root
DB_PASSWORD=
# Required for pooled PostgreSQL providers such as Neon after schema changes.
DB_EMULATE_PREPARES=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PRIVATE_STORAGE_ROOT=
PUBLIC_STORAGE_ROOT=
PUBLIC_ASSETS_ROOT=
QUEUE_CONNECTION=database
SANCTUM_EXPIRATION=60
DEFAULT_TEMPORARY_PASSWORD=password

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

BACKUP_DISK=private_documents
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=daily
BACKUP_INCLUDE_FILES=true
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# Melapays Payment Gateway Configuration
# --------------------------------------------------------------------------
# Mode options: 'sandbox' or 'production'
MELAPAYS_MODE=sandbox

# Gateway Base URL
# Sandbox Endpoint: https://84.247.186.98.nip.io
MELAPAYS_BASE_URL=https://84.247.186.98.nip.io

# Publishable Key (Client-side safe key)
MELAPAYS_PUBLISHABLE_KEY=

# Secret Key (Server-side API authentication)
MELAPAYS_SECRET_KEY=

# Webhook Secret (HMAC SHA-256 signature / header validation)
MELAPAYS_WEBHOOK_SECRET=
